{
  "name": "agarclone",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node index.ts",
    "dev": "concurrently -n build,server -c cyan,green \"npm:build:client -- --watch\" \"node --watch index.ts\"",
    "build:client": "esbuild public/uiStuff.ts public/canvasStuff.ts public/socketStuff.ts --outdir=public/dist",
    "typecheck": "tsc --noEmit && tsc -p public --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/admin-ui": "^0.5.1",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
