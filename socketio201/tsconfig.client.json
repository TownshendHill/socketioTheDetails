{
  /* Browser-side config. Separate from the root tsconfig because client code
     runs in a browser (needs DOM, must NOT see Node globals) and is bundled
     by esbuild rather than run directly by Node. */
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],

    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["slackClone/public/**/*.ts", "slackClone/contract/**/*.ts"]
}
